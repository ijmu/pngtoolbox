{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/webp-to-png-troubleshooting.html",
      "destination": "/webp-to-png.html#troubleshooting",
      "permanent": true
    },
    {
      "source": "/transparent-background-product-images.html",
      "destination": "/png-for-ecommerce.html",
      "permanent": true
    }
  ]
}
